#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: nvim-ssh SSH_DESTINATION ABSOLUTE_REMOTE_DIRECTORY [SESSION]

Attach to a persistent remote tmux session running Neovim. SESSION defaults to
nvim and may contain letters, digits, underscores, periods, and hyphens.
EOF
}

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    usage
    exit 0
fi
if (( $# < 2 || $# > 3 )); then
    usage >&2
    exit 2
fi

ssh_destination=$1
remote_directory=$2
session=${3:-nvim}

[[ $ssh_destination != -* ]] || { printf 'nvim-ssh: SSH destination must not begin with a dash\n' >&2; exit 2; }
[[ $remote_directory == /* ]] || { printf 'nvim-ssh: use an absolute remote directory\n' >&2; exit 2; }
[[ $session =~ ^[A-Za-z0-9_.-]+$ ]] || { printf 'nvim-ssh: invalid session name: %s\n' "$session" >&2; exit 2; }
command -v ssh >/dev/null 2>&1 || { printf 'nvim-ssh: ssh is not installed\n' >&2; exit 1; }

printf -v quoted_directory '%q' "$remote_directory"
printf -v quoted_session '%q' "$session"
remote_command="exec tmux new-session -A -s $quoted_session -c $quoted_directory 'nvim .'"
exec ssh -t "$ssh_destination" "$remote_command"
