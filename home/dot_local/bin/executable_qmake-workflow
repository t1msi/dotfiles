#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    cat <<'EOF'
Usage: qmake-workflow <command> [arguments...]

Commands:
  show                 Print the resolved project and tool paths
  configure [ARGS...]  Configure the shadow build with extra qmake arguments
  build [ARGS...]      Build with extra make arguments
  compdb [ARGS...]     Clean-build through Bear to generate compile_commands.json
  lint [REGEX...]      Run clang-tidy over the compilation database
  run [ARGS...]        Run the staged application
  debug [ARGS...]      Debug the staged application with GDB
  clean                Run the generated clean target
  clear                Remove the shadow build directory
  rebuild [ARGS...]    Clear, configure with extra qmake arguments, and build

Environment:
  QMAKE_PROJECT_FILE       Project file; otherwise discovered above $PWD
  QMAKE_BIN                qmake executable
  QMAKE_BUILD_DIR          Shadow directory, default: <project>/build
  QMAKE_BUILD_CONFIG       CONFIG value, default: debug
  QMAKE_PROJECT_ARG        PROJECT_ARG value, default: duck
  QMAKE_COURSE_USER_MODE   COURSE_USER_MODE value, default: developer
  QMAKE_RUN_TARGET         Staged executable name, default: Course
  QMAKE_JOBS               Parallel job count, default: nproc

Project configuration:
  .qmake-workflow.args     One persistent qmake argument per line
EOF
}

die() {
    printf 'qmake-workflow: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

resolve_project_file() {
    if [[ -n ${QMAKE_PROJECT_FILE:-} ]]; then
        realpath -e "$QMAKE_PROJECT_FILE" 2>/dev/null || die "project file not found: $QMAKE_PROJECT_FILE"
        return
    fi

    local directory=$PWD
    local candidates=()
    while :; do
        if [[ -f "$directory/qgroundcontrol.pro" ]]; then
            printf '%s\n' "$directory/qgroundcontrol.pro"
            return
        fi

        shopt -s nullglob
        candidates=("$directory"/*.pro)
        shopt -u nullglob
        if (( ${#candidates[@]} == 1 )); then
            printf '%s\n' "${candidates[0]}"
            return
        fi

        [[ $directory == / ]] && break
        directory=${directory%/*}
        [[ -n $directory ]] || directory=/
    done

    die "could not find a single .pro file above $PWD; set QMAKE_PROJECT_FILE"
}

print_command() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
}

command_name=${1:-help}
if (( $# > 0 )); then
    shift
fi

case $command_name in
    help | -h | --help)
        usage
        exit 0
        ;;
esac

require_command realpath
project_file=$(resolve_project_file)
project_root=$(dirname "$project_file")
qmake_bin=${QMAKE_BIN:-/opt/qt-everywhere-src-5.15.2/qtbase/bin/qmake}
build_dir=${QMAKE_BUILD_DIR:-$project_root/build}
if [[ $build_dir != /* ]]; then
    build_dir=$project_root/$build_dir
fi
build_dir=$(realpath -m "$build_dir")
jobs=${QMAKE_JOBS:-$(nproc)}
run_target=${QMAKE_RUN_TARGET:-Course}
staging_dir=$build_dir/staging
run_binary=$staging_dir/$run_target

qmake_arguments=(
    "CONFIG+=${QMAKE_BUILD_CONFIG:-debug}"
    "PROJECT_ARG=${QMAKE_PROJECT_ARG:-duck}"
    "COURSE_USER_MODE=${QMAKE_COURSE_USER_MODE:-developer}"
)
arguments_file=$project_root/.qmake-workflow.args
if [[ -f $arguments_file ]]; then
    while IFS= read -r argument || [[ -n $argument ]]; do
        [[ $argument =~ ^[[:space:]]*(#|$) ]] && continue
        qmake_arguments+=("$argument")
    done < "$arguments_file"
fi

configure_project() {
    [[ -x $qmake_bin ]] || die "qmake is not executable: $qmake_bin"
    mkdir -p "$build_dir"
    print_command "$qmake_bin" "$project_file" "${qmake_arguments[@]}" "$@"
    (
        cd "$build_dir"
        "$qmake_bin" "$project_file" "${qmake_arguments[@]}" "$@"
    )
    touch "$build_dir/.qmake-workflow-build"
}

ensure_configured() {
    if [[ ! -f $build_dir/Makefile ]]; then
        configure_project
    fi
}

build_project() {
    require_command make
    ensure_configured
    print_command make -C "$build_dir" "-j$jobs" "$@"
    make -C "$build_dir" "-j$jobs" "$@"
}

clear_build_directory() {
    [[ $build_dir != / && $build_dir != "$project_root" ]] || die "refusing to clear unsafe build directory: $build_dir"
    if [[ $build_dir != "$project_root"/* && ! -f $build_dir/.qmake-workflow-build ]]; then
        die "refusing to clear unmarked external build directory: $build_dir"
    fi
    if [[ -e $build_dir || -L $build_dir ]]; then
        print_command rm -rf -- "$build_dir"
        rm -rf -- "$build_dir"
    fi
}

case $command_name in
    show)
        printf 'project_file=%s\n' "$project_file"
        printf 'project_root=%s\n' "$project_root"
        printf 'qmake=%s\n' "$qmake_bin"
        printf 'build_dir=%s\n' "$build_dir"
        printf 'compile_commands=%s\n' "$build_dir/compile_commands.json"
        printf 'run_binary=%s\n' "$run_binary"
        printf 'configure_arguments='
        printf ' %q' "${qmake_arguments[@]}"
        printf '\n'
        ;;
    configure)
        configure_project "$@"
        ;;
    build)
        build_project "$@"
        ;;
    compdb)
        require_command bear
        require_command make
        ensure_configured
        print_command make -C "$build_dir" clean
        make -C "$build_dir" clean
        print_command bear --output "$build_dir/compile_commands.json" -- make "-j$jobs" "$@"
        (
            cd "$build_dir"
            bear --output "$build_dir/compile_commands.json" -- make "-j$jobs" "$@"
        )
        ;;
    lint)
        [[ -f $build_dir/compile_commands.json ]] || die "run 'qmake-workflow compdb' first"
        lint_command=$(command -v run-clang-tidy || true)
        if [[ -z $lint_command ]]; then
            shopt -s nullglob
            lint_commands=(/usr/bin/run-clang-tidy-*)
            shopt -u nullglob
            lint_command=${lint_commands[-1]:-}
        fi
        [[ -n $lint_command ]] || die "required command not found: run-clang-tidy"
        print_command "$lint_command" -p "$build_dir" "-j$jobs" "$@"
        "$lint_command" -p "$build_dir" "-j$jobs" "$@"
        ;;
    run)
        [[ -x $run_binary ]] || die "application not built: $run_binary"
        print_command "$run_binary" "$@"
        cd "$staging_dir"
        exec "$run_binary" "$@"
        ;;
    debug)
        require_command gdb
        [[ -x $run_binary ]] || die "application not built: $run_binary"
        print_command gdb --args "$run_binary" "$@"
        cd "$staging_dir"
        exec gdb --args "$run_binary" "$@"
        ;;
    clean)
        require_command make
        ensure_configured
        print_command make -C "$build_dir" clean
        make -C "$build_dir" clean
        ;;
    clear)
        clear_build_directory
        ;;
    rebuild)
        clear_build_directory
        configure_project "$@"
        build_project
        ;;
    *)
        usage >&2
        die "unknown command: $command_name"
        ;;
esac
